# SafeGas Monitor - Arquivo de Exemplo de Variaveis de Ambiente (.env.example)
# Copie este arquivo para '.env' (e configure 'config/secrets.py') antes de executar em producao.
# NUNCA versione o arquivo '.env' ou 'config/secrets.py' real no Git!

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
FLASK_HOST=127.0.0.1
FLASK_PORT=8000

SQLITE_DB_PATH=database/sql/safegas.db
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=safegas_monitor

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_google
ALERT_DEST_EMAIL=seguranca@empresa.com.br
