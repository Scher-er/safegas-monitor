# Credenciais SMTP para envio automático de laudos periciais de emergência (PDF)
# No Gmail, utilize uma "Senha de Aplicativo" gerada nas configurações da sua Conta Google:
SMTP_USER = "seu_email@gmail.com"
SMTP_PASS = "sua_senha_de_aplicativo_aqui"
